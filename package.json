{
  "name": "sisgov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write README.md package.json eslint.config.js src",
    "format:check": "prettier --check README.md package.json eslint.config.js src",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.70.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
